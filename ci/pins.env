# Every external version the CI tiers depend on, written only here.
# Format: KEY=value, one per line, literal values (no quotes, no $ expansion);
# lines starting with # are comments. Read by the Makefile (include), the bash
# harnesses (ci/load-pins.sh) and workflows (appended to $GITHUB_ENV). The
# copies that cannot read this file (guard.PauseImage, the Dockerfile's
# GO_BUILDER_IMAGE default, workflow uses: refs) are checked against it by
# test/journeys/catalog.

# golangci-lint release (github.com/golangci/golangci-lint/releases), installed
# with install-mode: goinstall so it is built with go.mod's toolchain.
GOLANGCI_LINT_VERSION=v2.4.0
# Helm release (github.com/helm/helm/releases).
HELM_VERSION=v4.3.2
# kind release (github.com/kubernetes-sigs/kind/releases), go install sigs.k8s.io/kind@<version>.
KIND_VERSION=v0.33.0
# kind node image for us-e2e and us-dev (hub.docker.com/r/kindest/node/tags).
KIND_NODE_IMAGE=kindest/node:v1.34.3
# Kubernetes versions of the policy matrix, kindest/node tags, space-separated.
POLICY_K8S_VERSIONS=v1.30.13 v1.32.11 v1.34.3
# Calico release tag (github.com/projectcalico/calico), manifests/calico.yaml.
CALICO_VERSION=v3.32.3
# Gateway API release (github.com/kubernetes-sigs/gateway-api/releases): the
# version NIC's Envoy Gateway builds against (pkg/argocd/templates/apps/envoy-gateway.yaml).
GATEWAY_API_VERSION=v1.6.1
# cert-manager chart version NIC pins at NIC_REQUIRED_COMMIT (pkg/argocd/templates/apps/*.yaml).
CERT_MANAGER_VERSION=v1.17.2
# trust-manager chart version NIC pins at NIC_REQUIRED_COMMIT (pkg/argocd/templates/apps/*.yaml).
TRUST_MANAGER_VERSION=v0.22.1
# nebari-infrastructure-core commit test/e2e/fixtures/nic is vendored from (make nic-fixtures-check).
NIC_FIXTURES_REF=de81b1131fbe26fca289f841347d84af727f692f
# nebari-infrastructure-core commit the service requires (nebari-dev/nebari-infrastructure-core#787).
NIC_REQUIRED_COMMIT=de81b1131fbe26fca289f841347d84af727f692f
# Go builder image, multi-arch index digest from: docker buildx imagetools inspect golang:1.26
GO_BUILDER_IMAGE=golang:1.26@sha256:6e59e17a20f13c102e49d82dffab66d41cffe6c266b225d82794328aea859ab5
# Probe pod image, multi-arch index digest from: docker buildx imagetools inspect registry.k8s.io/pause:3.10
PAUSE_IMAGE=registry.k8s.io/pause:3.10@sha256:ee6521f290b2168b6e0935a181d4cff9be1ac3f505666ef0e3c98fae8199917a
# Keycloak server image for the kind tier: the tag NIC v0.18.0 deploys
# (pkg/argocd/templates/values/keycloak/base.yaml image.tag, keycloakx chart in
# pkg/argocd/templates/apps/keycloak.yaml), multi-arch index digest from:
# docker buildx imagetools inspect quay.io/keycloak/keycloak:26.8.1
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.1@sha256:3f3c5f8e03c614774b4bd9173b88391fefa4153bfc010d8012d59ad825377332
# curl image for the e2e client pods (resolve consumers, Keycloak token client),
# multi-arch index digest from: docker buildx imagetools inspect docker.io/curlimages/curl:8.22.0
CURL_IMAGE=docker.io/curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777
# nebari-dev/action-nebari-sandbox release tag. Documentation only: GitHub does
# not template uses:, so workflow refs are written out and checked against this.
SANDBOX_ACTION_REF=v3.0.0
